# MISER loads a .env from the current directory, the project root, or ~/.miser.env.
# Keep real secrets in .env (git-ignored); never commit them.
BIFROST_URL=http://localhost:8080/openai
MISER_MODEL=provider/your-configured-model
# Optional resilience: tried in order after HTTP 429/503 from the primary model.
MISER_FALLBACK_MODELS=
# Optional two-model workflow: this reasoning model plans; the editor model patches.
MISER_ARCHITECT_MODEL=
# Optional, according to your gateway authentication configuration:
BIFROST_API_KEY=
BIFROST_VIRTUAL_KEY=
# Required only for live evidence searches:
TAVILY_API_KEY=
